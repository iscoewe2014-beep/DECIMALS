            // ─────────────────────────────────────
            // APP STATE
            // ─────────────────────────────────────
            const totalQuestions = questions.length;
            let currentQuestionIndex = 0;
            let inLessonMode = false;
            let attemptCount = 0;
            let totalPoints = 0;
            let isTransitioning = false;
            let completed = false;

            // DOM ELEMENTS
            const questionView = document.getElementById('questionView');
            const completionView = document.getElementById('completionView');
            const topicTag = document.getElementById('topicTag');
            const questionNumber = document.getElementById('questionNumber');
            const questionText = document.getElementById('questionText');
            const questionInstruction = document.getElementById('questionInstruction');
            const answerInput = document.getElementById('answerInput');
            const submitBtn = document.getElementById('submitBtn');
            const feedback = document.getElementById('feedback');
            const lessonPanel = document.getElementById('lessonPanel');
            const lessonTitle = document.getElementById('lessonTitle');
            const lessonBody = document.getElementById('lessonBody');
            const lessonExample = document.getElementById('lessonExample');
            const lessonKeypoint = document.getElementById('lessonKeypoint');
            const continueBtn = document.getElementById('continueBtn');
            const progressBar = document.getElementById('progressBar');
            const progressText = document.getElementById('progressText');
            const pointsDisplay = document.getElementById('pointsDisplay');
            const pointsBadge = document.getElementById('pointsBadge');
            const finalScore = document.getElementById('finalScore');
            const contentArea = document.getElementById('contentArea');

            function getCurrentQuestion() {
                return questions[currentQuestionIndex];
            }

            function normalizeAnswer(str) {
                let normalized = str.trim().toLowerCase()
                    .replace(/\s+/g, ' ')
                    .replace(/,/g, '')
                    .replace(/^\$/, '')
                    .replace(/\s*dollars$/, '')
                    .replace(/hundredths/g, 'hundredths')
                    .trim();
                return normalized;
            }

            function checkAnswer(userInput) {
                const question = getCurrentQuestion();
                const normalized = normalizeAnswer(userInput);
                return question.acceptableAnswers.some(ans =>
                    normalizeAnswer(ans) === normalized
                );
            }

            function updateProgress() {
                const progressPercent = Math.round((currentQuestionIndex / totalQuestions) * 100);
                progressBar.style.width = progressPercent + '%';
                progressText.textContent = 'Question ' + (currentQuestionIndex + 1) + ' of ' + totalQuestions;
            }

            function updatePoints(earned) {
                totalPoints += earned;
                pointsDisplay.textContent = totalPoints + ' pts';
                pointsBadge.classList.remove('pulse');
                void pointsBadge.offsetWidth;
                pointsBadge.classList.add('pulse');
            }

            function renderQuestion() {
                const question = getCurrentQuestion();
                topicTag.textContent = question.topic;
                questionNumber.textContent = 'Question ' + (currentQuestionIndex + 1) + ' of ' + totalQuestions;
                questionText.textContent = question.text;
                questionInstruction.textContent = question.instruction;
                answerInput.value = '';
                answerInput.className = 'answer-input';
                answerInput.disabled = false;
                answerInput.focus();
                submitBtn.disabled = false;
                submitBtn.textContent = '✅ Submit';
                feedback.className = 'feedback';
                feedback.textContent = '';
                feedback.style.display = 'none';
                lessonPanel.classList.remove('show');
                lessonPanel.style.display = 'none';
                inLessonMode = false;
                attemptCount = 0;
                updateProgress();
                document.getElementById('mainCard').scrollIntoView({ behavior: 'smooth', block: 'start' });
            }

            function showFeedback(isCorrect, message) {
                feedback.textContent = message;
                feedback.className = 'feedback show ' + (isCorrect ? 'correct' : 'wrong');
                feedback.style.display = 'flex';
            }

            function showLesson() {
                const question = getCurrentQuestion();
                const lesson = question.lesson;
                lessonTitle.textContent = lesson.title;
                lessonBody.textContent = lesson.body;
                lessonExample.innerHTML = lesson.example;
                lessonKeypoint.innerHTML = lesson.keypoint;
                lessonPanel.classList.add('show');
                lessonPanel.style.display = 'block';
                lessonPanel.scrollIntoView({ behavior: 'smooth', block: 'center' });
                inLessonMode = true;
            }

            function hideLesson() {
                lessonPanel.classList.remove('show');
                lessonPanel.style.display = 'none';
                inLessonMode = false;
            }

            function handleCorrectAnswer() {
                const question = getCurrentQuestion();
                let earnedPoints;
                if (attemptCount === 0) {
                    earnedPoints = question.points;
                } else if (attemptCount === 1) {
                    earnedPoints = Math.round(question.points * 0.6);
                } else {
                    earnedPoints = Math.round(question.points * 0.3);
                }
                if (earnedPoints < 1) earnedPoints = 1;

                updatePoints(earnedPoints);
                const attemptMsg = attemptCount === 0 ? 'First attempt! +' + earnedPoints + ' pts' :
                    'Correct! +' + earnedPoints + ' pts (after ' + (attemptCount + 1) + ' attempts)';
                showFeedback(true, '🎉 Correct! ' + attemptMsg);

                answerInput.className = 'answer-input input-correct';
                answerInput.disabled = true;
                submitBtn.disabled = true;
                submitBtn.textContent = '✓ Done';
                hideLesson();
                isTransitioning = true;

                setTimeout(() => {
                    if (currentQuestionIndex < totalQuestions - 1) {
                        currentQuestionIndex++;
                        renderQuestion();
                    } else {
                        showCompletion();
                    }
                    isTransitioning = false;
                }, 1800);
            }

            function handleWrongAnswer() {
                attemptCount++;
                showFeedback(false, '❌ Not quite right. Let\'s review the concept with a different example.');
                answerInput.className = 'answer-input input-wrong';
                answerInput.disabled = true;
                submitBtn.disabled = true;
                isTransitioning = true;

                setTimeout(() => {
                    showLesson();
                    isTransitioning = false;
                }, 1500);
            }

            function showCompletion() {
                completed = true;
                questionView.style.display = 'none';
                completionView.classList.add('show');
                completionView.style.display = 'block';
                finalScore.textContent = 'Total Points Earned: ' + totalPoints + ' ⭐';
                progressBar.style.width = '100%';
                progressText.textContent = 'All 20 Questions Complete! 🎉';
                topicTag.textContent = 'Completed';
                contentArea.scrollIntoView({ behavior: 'smooth', block: 'start' });
            }

            submitBtn.addEventListener('click', function() {
                if (isTransitioning || completed || inLessonMode) return;
                const userInput = answerInput.value.trim();
                if (userInput === '') {
                    answerInput.style.borderColor = '#ecc94b';
                    answerInput.placeholder = 'Please type your answer first...';
                    setTimeout(() => {
                        answerInput.style.borderColor = '';
                        answerInput.placeholder = 'Your answer...';
                    }, 1500);
                    return;
                }
                if (checkAnswer(userInput)) {
                    handleCorrectAnswer();
                } else {
                    handleWrongAnswer();
                }
            });

            answerInput.addEventListener('keydown', function(e) {
                if (e.key === 'Enter' && !isTransitioning && !completed && !inLessonMode) {
                    e.preventDefault();
                    submitBtn.click();
                }
            });

            continueBtn.addEventListener('click', function() {
                if (!inLessonMode || completed) return;
                hideLesson();
                answerInput.value = '';
                answerInput.className = 'answer-input';
                answerInput.disabled = false;
                answerInput.focus();
                submitBtn.disabled = false;
                submitBtn.textContent = '✅ Submit';
                feedback.className = 'feedback';
                feedback.textContent = '';
                feedback.style.display = 'none';
                answerInput.scrollIntoView({ behavior: 'smooth', block: 'center' });
            });

            function init() {
                currentQuestionIndex = 0;
                inLessonMode = false;
                attemptCount = 0;
                totalPoints = 0;
                isTransitioning = false;
                completed = false;
                questionView.style.display = 'block';
                completionView.classList.remove('show');
                completionView.style.display = 'none';
                pointsDisplay.textContent = '0 pts';
                renderQuestion();
                updateProgress();
            }

            init();
        })();
    </script>
